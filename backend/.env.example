PORT=3001
NODE_ENV=development

# AI Layer (Python FastAPI)
AI_LAYER_URL=http://localhost:8001
AI_PROVIDER=anthropic

# Telegram
# Create a bot with @BotFather. Keep its token only in backend/.env.
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
# Private channel: numeric ID including the -100 prefix.
# Bot must be an admin with Post Messages permission.
# npm run telegram:chats finds IDs; npm run telegram:check checks access.
TELEGRAM_CHAT_ID=your_chat_or_channel_id

# Scheduler (cron) - default 3 AM every day
CRON_SCHEDULE=0 3 * * *
